# Heimdall environment configuration.
# Copy to `.env` and adjust. Never commit a real `.env`.
# A full reference lives in docs/environment.md.

# --- Core -------------------------------------------------------------------
# local | test | preview | production
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# console | json  (use json in deployed environments)
LOG_FORMAT=console

# --- Database ---------------------------------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL=postgresql+asyncpg://heimdall:heimdall@localhost:5433/heimdall
# Direct (non-pooled) connection used by Alembic. Required by Neon and similar
# providers; leave empty locally.
DATABASE_URL_DIRECT=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Set to true on Vercel so the engine uses NullPool instead of a connection pool.
SERVERLESS=false

# --- HTTP -------------------------------------------------------------------
# Comma-separated list. Wildcards are rejected in production.
CORS_ALLOW_ORIGINS=http://localhost:5173
MAX_REQUEST_BODY_BYTES=2097152

# --- Docker Compose ---------------------------------------------------------
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=heimdall
POSTGRES_DB=heimdall
# Host port for the Compose database. 5433 by default, so a PostgreSQL
# installation already running on the host's 5432 does not conflict.
POSTGRES_PORT=5433
API_PORT=8000

# --- Authentication ---------------------------------------------------------
# Signs access tokens. Generate with: openssl rand -hex 32
# Leave unset locally to use the built-in development placeholder; preview and
# production startup FAILS unless a real value of at least 32 characters is set.
AUTH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=heimdall_refresh
# Must be true outside local development. When the frontend is on a different
# origin than the API, also set REFRESH_COOKIE_SAMESITE=none.
REFRESH_COOKIE_SECURE=false
# lax | strict | none
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
# Argon2id work factors. Raise time/memory on stronger hardware.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=1

# --- Market data ------------------------------------------------------------
# Only the offline fixture provider exists. Tests and local development use it, so
# no result depends on a third party.
MARKET_DATA_PROVIDER=fixture
MARKET_DATA_API_KEY=

# --- Early Warning System ---------------------------------------------------
# Protects POST /api/v1/internal/monitoring/run.
# Generate with: openssl rand -hex 32
# Leave empty to DISABLE scheduled monitoring: the endpoint then returns 503
# rather than running unprotected.
CRON_SECRET=
# Portfolios evaluated per scheduled invocation.
MONITORING_BATCH_SIZE=25

# --- Rate limiting ----------------------------------------------------------
# In-process fixed-window limiting on authentication and provider-backed endpoints.
RATE_LIMIT_ENABLED=true

# --- Reserved for later phases ----------------------------------------------
# VITE_API_BASE_URL=        # Phase 8, frontend only. Never place secrets in VITE_ vars.
