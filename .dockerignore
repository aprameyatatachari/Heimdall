# Keep the build context small and secrets out of the image.
.git/
.github/
.venv/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/node_modules/
frontend/dist/
.vercel/
.idea/
.vscode/
prompt.md
*.log

# Never copy real environment files into an image.
.env
.env.*
!.env.example
